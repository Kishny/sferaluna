# Résolution des peer dependencies en mode compatible (npm v6).
# Nécessaire car certains paquets (ex : @vercel/analytics) déclarent des peers
# optionnels multi-frameworks que npm v7+ tente de résoudre trop strictement,
# provoquant des conflits ERESOLVE avec la version de vite du projet.
# S'applique aussi au build Vercel (npm install au déploiement).
legacy-peer-deps=true
