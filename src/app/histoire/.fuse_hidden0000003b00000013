interface SiteStats { membres: number; matchs: number; messages: number; evenements: number; }

function formatStat(n: number): string {
    if (n >= 1000) return (n / 1000).toFixed(1).replace('.0', '') + 'K+';
    if (n === 0) return '—';
    return n.toString();
